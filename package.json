  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": { "node": ">=20" },
  "keywords": ["ai", "ai-sdk", "vercel-ai-sdk", "vercel", "tools", "agents", "web-search", "search", "extract", "scraping", "markdown", "headless-browser", "news", "screenshot", "x402", "rag", "agentsearch", "llm"],
  "license": "MIT",
  "homepage": "https://agentsearchhq.com/blog/add-web-search-to-vercel-ai-sdk?utm_source=agentsearchhq-ai-sdk&utm_medium=package",
  "peerDependencies": { "ai": ">=5.0.0 <8.0.0", "zod": "^3.25.0 || ^4.0.0" },
  "dependencies": { "@x402/core": "^2.26.0", "@x402/evm": "^2.26.0", "viem": "^2.57.4" },
  "devDependencies": { "ai": "^7.0.0", "zod": "^4.0.0", "@types/node": "^22.10.0", "typescript": "^5.7.0" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/agentsearchhq-coder/agentsearch-ai-sdk.git" },
  "bugs": { "url": "https://github.com/agentsearchhq-coder/agentsearch-ai-sdk/issues" }
}
